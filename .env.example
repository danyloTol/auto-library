# ==========================================
# AutoLibrary Environment Configuration
# Скопіюйте цей файл у `.env` та вставте ваші реальні значення
# ==========================================

# Рядок підключення до PostgreSQL (NeonDB)
# Формат: Host=ep-xyz.region.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=ВАШ_ПАРОЛЬ;SSL Mode=Require;Trust Server Certificate=true
ConnectionStrings__DefaultConnection=Host=ep-xyz.eu-central-1.aws.neon.tech;Database=neondb;Username=neondb_owner;Password=ВАШ_ПАРОЛЬ;SSL Mode=Require;Trust Server Certificate=true

# JWT секретний ключ для підпису токенів (мінімум 32 символи)
Jwt__Key=super_secret_car_library_key_2026_very_long_and_safe_jwt_token_secret_key_12345!
Jwt__Issuer=AutoLibraryApi
Jwt__Audience=AutoLibraryClient
Jwt__ExpiryMinutes=1440
